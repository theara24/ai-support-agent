# ==========================================
# Theara AI Support Platform - Production Environment Configuration
# ==========================================

NODE_ENV=production
PORT=3001
WORKER_PORT=3001

# Database (Supabase PostgreSQL with pgvector)
# - DATABASE_URL: Supabase Transaction Pooler (port 6543 with ?pgbouncer=true)
# - DIRECT_URL: Supabase Direct Connection (port 5432 for migrations)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Redis Configuration (Render Managed Redis or Upstash)
# Use REDIS_URL for cloud Redis, or REDIS_HOST / REDIS_PORT for standard setups
REDIS_URL="redis://red-xxxxxxxx:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets (min 32 characters)
JWT_SECRET=your_production_jwt_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGIN=https://theara-ai-support-agent.vercel.app,http://localhost:3000,http://localhost:3002
CORS_ORIGINS=https://theara-ai-support-agent.vercel.app,http://localhost:3000,http://localhost:3002

# AI LLM & Embedding Providers
# - 'gemini': Uses live Google Gemini (gemini-flash-lite-latest & gemini-embedding-001)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Email Notification (Optional - for sending approval emails automatically)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Theara AI Support <onboarding@resend.dev>"

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# File Storage
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads
