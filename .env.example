# System Configuration
NODE_ENV=development
PORT=3000
WORKER_PORT=3001
WEB_PORT=3002

# Database (PostgreSQL with pgvector via docker-compose)
POSTGRES_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_support_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/ai_support_db?schema=public"

# Redis Configuration (BullMQ & Cache via docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# LLM & Embedding Providers
# AI_PROVIDER can be: gemini | demo | openai | anthropic
# - 'gemini': Uses live Google Gemini (gemini-flash-lite-latest & text-embedding-004 / gemini-embedding-001)
# - 'demo': Deterministic sandbox mode requiring zero external API keys
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Integration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# Upload & File Storage
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads

