# ==========================================
# Theara AI Support Platform - Web App Environment Configuration (Vercel)
# ==========================================

# Backend API & WebSocket URLs (Render Web Service)
NEXT_PUBLIC_API_URL=https://theara-ai-support-api.onrender.com
NEXT_PUBLIC_WS_URL=https://theara-ai-support-api.onrender.com
NEXT_PUBLIC_APP_URL=https://theara-ai-support-agent.vercel.app

# Supabase PostgreSQL Connection Pooler (used by Next.js Server Components & Route Handlers)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Authentication Secrets (Must match Render API JWT_SECRET)
JWT_SECRET=your_production_jwt_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_characters_here

# Resend Email Notification (Optional - to dispatch automatic onboarding approval emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Theara AI Support <onboarding@resend.dev>"
